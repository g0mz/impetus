[Unit]
Description=Impetus — assistente pessoal (WhatsApp + Claude)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=impetus
Group=impetus
WorkingDirectory=/home/impetus/impetus
EnvironmentFile=/etc/impetus/env
EnvironmentFile=/etc/impetus/env.app
Environment=PATH=/home/impetus/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

# Limites (A1 2 OCPU/12 GB; reduza para E2.1.Micro)
MemoryMax=1500M

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/impetus
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
