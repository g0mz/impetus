# /etc/fitcoach/env.app — configuração não secreta
# Segredos ficam em /etc/fitcoach/env (modo 600):
#   CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
#   CLAUDE_TOKEN_EXPIRES_AT=YYYY-MM-DD
#   INGEST_API_KEY=<openssl rand -hex 32>
#   FITCOACH_ANTHROPIC_API_KEY=   (só se BRAIN_PROVIDER=anthropic-api; NÃO use ANTHROPIC_API_KEY, conflita com o token da CLI)
#   GEMINI_API_KEY=               (só se BRAIN_PROVIDER=gemini)

NODE_ENV=production
TZ=America/Sao_Paulo
LOG_LEVEL=info

# Dados
DATA_DIR=/home/fitcoach/fitcoach/data
DAY_CUTOFF_HOUR=4

# Canal: whatsapp | terminal | telegram
CHANNEL=whatsapp
WA_SEND_MIN_INTERVAL_MS=1000

# Cérebro: claude-cli | anthropic-api | gemini | none (none = só comandos e fallbacks determinísticos)
BRAIN_PROVIDER=claude-cli
CLAUDE_BIN=claude
MODEL_FAST=haiku
MODEL_VISION=sonnet
MODEL_REPORT=sonnet
BRAIN_TIMEOUT_MS=120000
BRAIN_MAX_TURNS=15
BRAIN_RETRY_DELAY_MS=5000

# Portas (só loopback; exposição via Tailscale Serve ou Caddy)
MCP_PORT=8788
INGEST_PORT=8787

# Turnos
DEBOUNCE_MS=4000
DEBOUNCE_IMAGE_MS=20000
OPEN_SESSION_HOURS=3
CONTEXT_RECENT_TURNS=8

# Relatórios
REPORT_DAILY=false
REPORT_DAILY_TIME=21:30
REPORT_WEEKLY_CRON=0 20 * * 0
REPORT_MONTHLY_CRON=0 9 1 * *
REPORT_CHARTS=true

# Integrações
OFF_USER_AGENT=FitCoach/0.1 (uso pessoal)
HC_STALE_HOURS=48
