# /etc/impetus/env.app — configuração não secreta
# Segredos ficam em /etc/impetus/env (modo 600):
#   CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
#   CLAUDE_TOKEN_EXPIRES_AT=YYYY-MM-DD
#   TELEGRAM_BOT_TOKEN=          (só se CHANNEL=telegram; do @BotFather)
#   INGEST_API_KEY=<openssl rand -hex 32>
#   IMPETUS_ANTHROPIC_API_KEY=   (só se BRAIN_PROVIDER=anthropic-api; NÃO use ANTHROPIC_API_KEY, conflita com o token da CLI)
#   GEMINI_API_KEY=               (só se BRAIN_PROVIDER=gemini)

NODE_ENV=production
TZ=America/Sao_Paulo
LOG_LEVEL=info

# Dados
DATA_DIR=/home/impetus/impetus/data
# cwd do `claude -p`; precisa ficar FORA do repositório (docs/DECISIONS.md D-004)
BRAIN_DIR=/home/impetus/.local/state/impetus/brain
DAY_CUTOFF_HOUR=4

# Canal: whatsapp | terminal | telegram
CHANNEL=whatsapp
WA_SEND_MIN_INTERVAL_MS=1000

# Cérebro: claude-cli | anthropic-api | gemini | none (none = só comandos e fallbacks determinísticos)
BRAIN_PROVIDER=claude-cli
CLAUDE_BIN=claude
# Isolamento do coach (D-018): setting-sources | safe-mode | none
BRAIN_ISOLATION=setting-sources
MODEL_FAST=haiku
MODEL_VISION=sonnet
MODEL_REPORT=sonnet
BRAIN_TIMEOUT_MS=120000
BRAIN_MAX_TURNS=15
BRAIN_RETRY_DELAY_MS=5000

# Portas (só loopback; exposição via Tailscale Serve ou Caddy)
MCP_PORT=8788
INGEST_PORT=8787

# Turnos
DEBOUNCE_MS=4000
DEBOUNCE_IMAGE_MS=20000
OPEN_SESSION_HOURS=3
CONTEXT_RECENT_TURNS=8

# Relatórios
REPORT_DAILY=false
REPORT_DAILY_TIME=21:30
REPORT_WEEKLY_CRON=0 20 * * 0
REPORT_MONTHLY_CRON=0 9 1 * *
REPORT_CHARTS=true

# Integrações
OFF_USER_AGENT=Impetus/0.1 (uso pessoal)
HC_STALE_HOURS=48

# Mensagens de voz (D-030): none = responde pedindo texto; whisper-cpp = transcrição local (setup-vm.sh instala).
TRANSCRIBE=none
# WHISPER_BIN=/home/impetus/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL=/home/impetus/whisper.cpp/models/ggml-small-q5_1.bin
# WHISPER_THREADS=2
FFMPEG_BIN=ffmpeg
AUDIO_MAX_SECONDS=180

# Backup diário 03:30 em DATA_DIR/backups (retenção local em dias). Remote rclone opcional (ex.: gcrypt:impetus);
# vazio = só local. data/wa-auth nunca entra no backup.
# BACKUP_REMOTE=gcrypt:impetus
BACKUP_KEEP_DAYS=14
