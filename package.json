{
  "name": "impetus",
  "version": "0.1.0",
  "private": true,
  "description": "Assistente pessoal de treino, nutrição e saúde via WhatsApp",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-assets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:migrate": "node scripts/db-migrate.ts",
    "db:seed": "node scripts/db-seed.ts",
    "routines:import": "node --env-file-if-exists=.env scripts/routines-import.ts",
    "chat": "node --env-file-if-exists=.env scripts/chat.ts",
    "eval": "node --env-file-if-exists=.env scripts/eval.ts",
    "simulate": "node --env-file-if-exists=.env scripts/simulate.ts",
    "eval:report": "node scripts/eval-report.ts",
    "wa:link": "node --env-file-if-exists=.env scripts/wa-link.ts",
    "restore": "node scripts/restore.ts",
    "hc:fixture": "node scripts/hc-fixture.ts",
    "logs:pretty": "pino-pretty"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@resvg/resvg-js": "2.6.2",
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "13.0.3",
    "croner": "10.0.1",
    "execa": "10.1.1",
    "hono": "4.13.13",
    "p-queue": "10.0.0",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "vega": "6.4.0",
    "vega-lite": "6.4.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "eslint": "10.12.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
